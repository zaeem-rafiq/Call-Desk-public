# Copy to .env and fill in. Any blank key runs that integration in MOCK mode.
# Never commit .env.

# 1. Gemini (transcription, claim extraction, fact-check agent, TTS)
GEMINI_API_KEY=

# 2. Sentry (errors + AI agent tracing). SENTRY_ORG is your org slug, used for trace links.
SENTRY_DSN=
SENTRY_ORG=

# 3. Tiger Data (TimescaleDB) connection string, e.g. postgres://tsdbadmin:...@xxx.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
TIGER_DATABASE_URL=

# 4. Snowflake (prior-quarter warehouse + Cortex Search)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CALLDESK
SNOWFLAKE_SCHEMA=PRIOR

# 5. Nimble (live web search + extraction)
NIMBLE_API_KEY=

# Optional overrides: force a mock even when a key is present (1 = mock)
# MOCK_GEMINI=0
# MOCK_NIMBLE=0
# MOCK_TIGER=0
# MOCK_SNOWFLAKE=0
# MOCK_SENTRY=0
